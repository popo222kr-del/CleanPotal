<UserControl x:Class="CleanPotal.FieldChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="under" Height="3" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" Margin="6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="under" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="Control">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ItemsDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style x:Key="ItemsGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 모바일 데일리 체크 웹서버 상태 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,4" Padding="16,12">
            <DockPanel LastChildFill="True">
                <Ellipse x:Name="WebServerDot" Width="10" Height="10" Fill="#94A3B8" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button x:Name="BtnToggleWebServer" Content="모바일 페이지 시작" Style="{StaticResource PrimaryButtonStyle}"
                        DockPanel.Dock="Right" Click="BtnToggleWebServer_Click" Margin="8,0,0,0"/>
                <Button x:Name="BtnCopyWebUrl" Content="주소 복사" Style="{StaticResource GhostButtonStyle}"
                        DockPanel.Dock="Right" Click="BtnCopyWebUrl_Click" IsEnabled="False"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WebServerStatusText" Text="모바일 데일리 체크 페이지: 꺼짐"
                               FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock x:Name="WebServerUrlText" Text="시작하면 휴대폰에서 접속할 사내망 주소가 표시됩니다. (이 PC가 켜져 있을 때만 접속 가능)"
                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 탭 영역 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="점검 현황 대시보드" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="전체 점검 대상" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="StatTotalText" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="점검 완료" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="StatDoneText" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="미점검" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="StatPendingText" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="이상 발생" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="StatAbnormalText" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#EF4444" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="6,12,6,0">
                        <StackPanel>
                            <TextBlock Text="대시보드 상세 (위치별 진행률 / 최근 점검 / 이상 발생)"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <TextBlock Text="위치별 진행률 ProgressBar 와 최근 점검·이상 발생 목록."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="NFC / QR 관리" Style="{StaticResource TabHeaderStyle}">
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="NFC 태그 / QR 코드 등록"
                                   FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <TextBlock Text="좌측에 위치 목록, 우측에 선택 위치의 태그·QR 미리보기·발급/재발급 버튼 배치."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="새 위치 등록" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="새 태그 발급" Style="{StaticResource GhostButtonStyle}" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="QR 출력" Style="{StaticResource GhostButtonStyle}" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="체크시트 관리" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 체크시트 목록 (분류별 그룹핑) -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,12,0" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="체크시트 목록" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="분류(Category)별로 묶어서 표시됩니다. 시트가 많아져도 코드/분류로 쉽게 구분하세요."
                                           FontSize="11" Foreground="#94A3B8" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                <Button x:Name="BtnNewChecklist" Content="+ 새 체크시트"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Click="BtnNewChecklist_Click"/>
                            </StackPanel>
                            <ListBox x:Name="LstChecklists" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="LstChecklists_SelectionChanged">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                                           Foreground="#94A3B8" Margin="6,12,0,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Code}" FontSize="10" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Cycle}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 우측: 체크시트 상세 + 항목 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="TxtChecklistFormTitle" Text="체크시트 정보 (새 체크시트)"
                                           FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="코드 (Code) — 시트 식별용 짧은 키" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtChecklistCode" Style="{StaticResource FieldInputStyle}"
                                                 ToolTip="예) 5S-METAL, SAFETY-INJECTION"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,10">
                                        <TextBlock Text="분류 (Category)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbChecklistCategory" IsEditable="True" Style="{StaticResource FieldInputStyle}"
                                                  ToolTip="예) 5S 점검, 안전 점검, 설비 순회점검"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="이름 (Name)" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="TxtChecklistName" Style="{StaticResource FieldInputStyle}"
                                                 ToolTip="예) METAL [입고검사실, 세정실] 5S Check Sheet"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="위치 (Location)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbChecklistLocation" Style="{StaticResource FieldInputStyle}"
                                                  DisplayMemberPath="Name" SelectedValuePath="LocationId"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="주기 (Cycle)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CmbChecklistCycle" Style="{StaticResource FieldInputStyle}">
                                            <ComboBoxItem Content="DAILY"/>
                                            <ComboBoxItem Content="WEEKLY"/>
                                            <ComboBoxItem Content="MONTHLY"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Grid.Column="2" LastChildFill="False" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="ChkChecklistActive" Content="사용함" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,16,8" DockPanel.Dock="Left"/>
                                        <Button x:Name="BtnDeleteChecklist" Content="삭제" Style="{StaticResource GhostButtonStyle}"
                                                Click="BtnDeleteChecklist_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <Button x:Name="BtnSaveChecklist" Content="저장" Style="{StaticResource PrimaryButtonStyle}"
                                                Click="BtnSaveChecklist_Click" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="체크 항목" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="구분(섹션) · 교대 값을 채우면 데일리 화면에서 자동으로 그룹핑되어 표시됩니다."
                                                   FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button x:Name="BtnAddItem" Content="+ 항목 추가" Style="{StaticResource GhostButtonStyle}"
                                                Click="BtnAddItem_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnDeleteItem" Content="선택 항목 삭제" Style="{StaticResource GhostButtonStyle}"
                                                Click="BtnDeleteItem_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="DgChecklistItems" Style="{StaticResource ItemsDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource ItemsGridHeaderStyle}"
                                          CanUserAddRows="False"
                                          CellEditEnding="DgChecklistItems_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="순서" Binding="{Binding OrderNo}" Width="55"/>
                                        <DataGridTextColumn Header="구분(섹션)" Binding="{Binding SectionName}" Width="110"/>
                                        <DataGridTextColumn Header="교대" Binding="{Binding ShiftLabel}" Width="80"/>
                                        <DataGridTextColumn Header="점검 항목" Binding="{Binding Title}" Width="3*" MinWidth="240"/>
                                        <DataGridComboBoxColumn Header="입력 형식" SelectedItemBinding="{Binding InputType}" Width="110">
                                            <DataGridComboBoxColumn.ItemsSource>
                                                <x:Array Type="{x:Type sys:String}">
                                                    <sys:String>OK_NG</sys:String>
                                                    <sys:String>YES_NO</sys:String>
                                                    <sys:String>NUMBER</sys:String>
                                                    <sys:String>TEXT</sys:String>
                                                </x:Array>
                                            </DataGridComboBoxColumn.ItemsSource>
                                        </DataGridComboBoxColumn>
                                        <DataGridTextColumn Header="단위/힌트" Binding="{Binding UnitOrHint}" Width="100"/>
                                        <DataGridCheckBoxColumn Header="필수" Binding="{Binding IsRequired}" Width="50"/>
                                        <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="2*" MinWidth="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="점검 기록 조회" Style="{StaticResource TabHeaderStyle}">
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="점검 기록 조회 / 출력 / 엑셀 내보내기"
                                   FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <TextBlock Text="기간 / 위치 / 작업자 / 상태 / 이상 여부 필터와 결과 그리드, 행 더블클릭 시 상세 모달 영역."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
