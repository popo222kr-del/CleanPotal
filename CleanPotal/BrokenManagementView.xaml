<UserControl x:Class="CleanPotal.BrokenManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanPotal"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="#94A3B8" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsTabStop="False"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   Placement="Bottom">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" Opacity="0.1" BlurRadius="16" ShadowDepth="4" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="bd" Property="Background" Value="#FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab header -->
        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="under" Height="3" CornerRadius="2" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" Background="Transparent" Margin="6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="under" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <Style x:Key="SmallAttachStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="BrokenDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cell center style -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Thumbnail converters -->
        <local:FileThumbnailConverter    x:Key="FileThumbnailConverter"/>
        <local:IsImageFileConverter      x:Key="IsImageFileConverter"/>
        <local:IsNotImageFileConverter   x:Key="IsNotImageFileConverter"/>
        <local:FileTypeTextConverter     x:Key="FileTypeTextConverter"/>
        <local:FileTypeBgConverter       x:Key="FileTypeBgConverter"/>

        <!-- ✕ Remove-file button -->
        <Style x:Key="RemoveFileBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#BB334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared thumbnail card — reused by all 4 attachment columns -->
        <DataTemplate x:Key="FileThumbnailItemTemplate">
            <Border Width="72" Margin="2,2,2,0" CornerRadius="6" BorderThickness="1"
                    BorderBrush="#E2E8F0" ClipToBounds="True" Cursor="Hand"
                    Tag="{Binding}" MouseLeftButtonUp="FileChip_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Image thumbnail -->
                    <Image Grid.Row="0"
                           Source="{Binding Converter={StaticResource FileThumbnailConverter}}"
                           Stretch="UniformToFill"
                           Visibility="{Binding Converter={StaticResource IsImageFileConverter}}"/>

                    <!-- Non-image type badge -->
                    <Border Grid.Row="0"
                            Background="{Binding Converter={StaticResource FileTypeBgConverter}}"
                            Visibility="{Binding Converter={StaticResource IsNotImageFileConverter}}">
                        <TextBlock Text="{Binding Converter={StaticResource FileTypeTextConverter}}"
                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Filename bar -->
                    <Border Grid.Row="1" Background="#F1F5F9" Padding="4,2">
                        <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                   FontSize="9" Foreground="#475569"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Converter={StaticResource FileNameConverter}}"/>
                    </Border>

                    <!-- ✕ remove -->
                    <Button Grid.Row="0"
                            Content="✕" Tag="{Binding}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="16" Height="16"
                            Style="{StaticResource RemoveFileBtnStyle}"
                            Click="RemoveFile_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 드랍존 + 메모 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="0">
            <Grid MinHeight="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <!-- Drop zone -->
                <Border x:Name="DropZoneBg" Grid.Column="0"
                        Background="#F8FAFC" CornerRadius="11,0,0,11"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        DragLeave="DropZone_DragLeave"
                        Drop="DropZone_Drop"
                        Cursor="Hand"
                        MouseLeftButtonUp="DropZone_Click">
                    <Grid Margin="16,10">
                        <!-- Dashed border overlay -->
                        <Rectangle x:Name="RectDash"
                                   Stroke="#CBD5E1" StrokeThickness="1.5"
                                   StrokeDashArray="6,3" RadiusX="8" RadiusY="8"
                                   Fill="Transparent" IsHitTestVisible="False"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10">
                            <TextBlock x:Name="TxtDropIcon" Text="📂" FontSize="26"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtDropHint"
                                       Text="xlsx 파일을 여기에 드래그하세요"
                                       FontSize="13" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="또는 클릭하여 선택" FontSize="11" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtFilePath" Text="" FontSize="11"
                                           Foreground="#2563EB" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                <TextBlock x:Name="TxtRecordCount" Text="" FontSize="11"
                                           Foreground="#64748B" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Fill="#E2E8F0" Margin="0,10"/>

                <!-- 메모 -->
                <Grid Grid.Column="2" Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="메모" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="TxtMemo"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12" Foreground="#334155"
                                 Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                 Padding="8,6" MinHeight="62">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="메모를 입력하세요..." FontSize="12" Foreground="#CBD5E1"
                                   Margin="10,8" IsHitTestVisible="False" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtMemo}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 탭 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- Tab 1: Broken 현황 -->
            <TabItem Header="Broken 현황" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 필터 바 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="16,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="년도" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbYear" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged" Margin="0,0,16,0"/>

                            <TextBlock Text="라인" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbLine" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged" Margin="0,0,16,0"/>

                            <TextBlock Text="팀" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbTeam" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged" Margin="0,0,16,0"/>

                            <Button Content="초기화" Style="{StaticResource GhostButtonStyle}"
                                    Click="BtnResetFilter_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 데이터 그리드 -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="DgBroken"
                                  Style="{StaticResource BrokenDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="발생일" Binding="{Binding OccurDateShort}" Width="110"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="제품명" Binding="{Binding ProductName}" Width="2*" MinWidth="160"/>

                                <DataGridTextColumn Header="S/N" Binding="{Binding SN}" Width="130"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="팀" Binding="{Binding Team}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="유발자" Binding="{Binding Causer}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="직위" Binding="{Binding JobTitle}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="제품종류" Binding="{Binding ProductType}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="발생단계" Binding="{Binding OccurStage}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="처리현황" Binding="{Binding Status}" Width="120"/>

                                <!-- ── 경위서 ── -->
                                <DataGridTemplateColumn Header="경위서" Width="*" MinWidth="110" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border AllowDrop="True"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropIncident_Drop"
                                                    Tag="{Binding}" Background="Transparent" Padding="4">
                                                <StackPanel>
                                                    <Button Content="📎" Tag="{Binding}"
                                                            Style="{StaticResource SmallAttachStyle}"
                                                            Click="BtnAttachIncident_Click"
                                                            HorizontalAlignment="Left"/>
                                                    <ItemsControl ItemsSource="{Binding IncidentReports}"
                                                                  Margin="0,4,0,0"
                                                                  ItemTemplate="{StaticResource FileThumbnailItemTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 대책서 ── -->
                                <DataGridTemplateColumn Header="대책서" Width="*" MinWidth="110" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border AllowDrop="True"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropCountermeasure_Drop"
                                                    Tag="{Binding}" Background="Transparent" Padding="4">
                                                <StackPanel>
                                                    <Button Content="📎" Tag="{Binding}"
                                                            Style="{StaticResource SmallAttachStyle}"
                                                            Click="BtnAttachCountermeasure_Click"
                                                            HorizontalAlignment="Left"/>
                                                    <ItemsControl ItemsSource="{Binding CountermeasureReports}"
                                                                  Margin="0,4,0,0"
                                                                  ItemTemplate="{StaticResource FileThumbnailItemTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 교육서 ── -->
                                <DataGridTemplateColumn Header="교육서" Width="*" MinWidth="110" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border AllowDrop="True"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropTraining_Drop"
                                                    Tag="{Binding}" Background="Transparent" Padding="4">
                                                <StackPanel>
                                                    <Button Content="📎" Tag="{Binding}"
                                                            Style="{StaticResource SmallAttachStyle}"
                                                            Click="BtnAttachTraining_Click"
                                                            HorizontalAlignment="Left"/>
                                                    <ItemsControl ItemsSource="{Binding TrainingDocs}"
                                                                  Margin="0,4,0,0"
                                                                  ItemTemplate="{StaticResource FileThumbnailItemTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 교육이미지 ── -->
                                <DataGridTemplateColumn Header="교육이미지" Width="*" MinWidth="110" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border AllowDrop="True"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropTrainingImages_Drop"
                                                    Tag="{Binding}" Background="Transparent" Padding="4">
                                                <StackPanel>
                                                    <Button Content="📎" Tag="{Binding}"
                                                            Style="{StaticResource SmallAttachStyle}"
                                                            Click="BtnAttachTrainingImages_Click"
                                                            HorizontalAlignment="Left"/>
                                                    <ItemsControl ItemsSource="{Binding TrainingImages}"
                                                                  Margin="0,4,0,0"
                                                                  ItemTemplate="{StaticResource FileThumbnailItemTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 팀별 집계 -->
            <TabItem Header="팀별 집계" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="16,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="팀별 Broken 사고 집계 및 보상율 현황"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
                                <TextBlock Text="ACC 제품 → 사고비중 0.5 적용"
                                           FontSize="11" Foreground="#92400E" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="DgTeamSummary"
                                  Style="{StaticResource BrokenDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="팀" Binding="{Binding Team}" Width="120"
                                                    ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="사고건수" Binding="{Binding RawCount}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="합계(ACC 0.5적용)"
                                                    Binding="{Binding WeightedCount, StringFormat={}{0:0.##}}"
                                                    Width="140" ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="목표달성" Binding="{Binding AchievedStr}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="지급예정월" Binding="{Binding PaymentMonth}" Width="130"
                                                    ElementStyle="{StaticResource CenterCell}"/>
                                <DataGridTextColumn Header="보상율" Binding="{Binding RewardRate}" Width="*"
                                                    ElementStyle="{StaticResource CenterCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
