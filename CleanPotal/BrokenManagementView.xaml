<UserControl x:Class="CleanPotal.BrokenManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="under" Height="3" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" Margin="6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="under" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BrokenDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 파일 불러오기 영역 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnLoadFile" Content="파일 불러오기"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnLoadFile_Click"
                        ToolTip="Excel 파일(.xlsx)을 선택하여 Broken 데이터를 불러옵니다."/>

                <TextBlock Grid.Column="1" x:Name="TxtFilePath"
                           Text="파일을 선택하세요..."
                           FontSize="12" Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="2" x:Name="TxtRecordCount"
                           Text=""
                           FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- 탭 영역 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- Tab 1: Broken 현황 -->
            <TabItem Header="Broken 현황" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 필터 바 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="년도" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbYear" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged"
                                      Margin="0,0,16,0"/>

                            <TextBlock Text="라인" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbLine" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged"
                                      Margin="0,0,16,0"/>

                            <TextBlock Text="팀" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbTeam" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="Filter_SelectionChanged"
                                      Margin="0,0,16,0"/>

                            <Button Content="필터 초기화" Style="{StaticResource GhostButtonStyle}"
                                    Click="BtnResetFilter_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 데이터 그리드 -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
                        <DataGrid x:Name="DgBroken"
                                  Style="{StaticResource BrokenDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="50"/>
                                <DataGridTextColumn Header="발생일" Binding="{Binding OccurDateStr}" Width="110"/>
                                <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="80"/>
                                <DataGridTextColumn Header="제품명" Binding="{Binding ProductName}" Width="140"/>
                                <DataGridTextColumn Header="S/N" Binding="{Binding SN}" Width="120"/>
                                <DataGridTextColumn Header="팀" Binding="{Binding Team}" Width="80"/>
                                <DataGridTextColumn Header="유발자" Binding="{Binding Causer}" Width="80"/>
                                <DataGridTextColumn Header="직위" Binding="{Binding JobTitle}" Width="90"/>
                                <DataGridTextColumn Header="발생시경력" Binding="{Binding CareerAtOccur}" Width="110"/>
                                <DataGridTextColumn Header="제품종류" Binding="{Binding ProductType}" Width="80"/>
                                <DataGridTextColumn Header="사고비중" Binding="{Binding WeightStr}" Width="90"/>
                                <DataGridTextColumn Header="발생단계" Binding="{Binding OccurStage}" Width="90"/>
                                <DataGridTextColumn Header="처리현황" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 팀별 집계 -->
            <TabItem Header="팀별 집계" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 안내 카드 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="팀별 Broken 사고 집계 및 보상율 현황"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  ACC 제품은 사고비중 0.5 적용"
                                       FontSize="12" Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 집계 그리드 -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
                        <DataGrid x:Name="DgTeamSummary"
                                  Style="{StaticResource BrokenDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="팀" Binding="{Binding Team}" Width="100"/>
                                <DataGridTextColumn Header="사고건수" Binding="{Binding RawCount}" Width="90"/>
                                <DataGridTextColumn Header="ACC보정" Binding="{Binding WeightedCount, StringFormat={}{0:0.##}}" Width="90"/>
                                <DataGridTextColumn Header="합계(0.5적용)" Binding="{Binding WeightedCount, StringFormat={}{0:0.##}}" Width="120"/>
                                <DataGridTextColumn Header="목표달성" Binding="{Binding AchievedStr}" Width="90"/>
                                <DataGridTextColumn Header="지급예정월" Binding="{Binding PaymentMonth}" Width="110"/>
                                <DataGridTextColumn Header="보상율" Binding="{Binding RewardRate}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
