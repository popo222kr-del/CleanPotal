<UserControl x:Class="CleanPotal.BrokenManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanPotal"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Filter ComboBox -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <!-- 화살표 아이콘 -->
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#64748B" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsHitTestVisible="False" x:Name="arrow"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsTabStop="False"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   Placement="Bottom"
                                   VerticalOffset="-34">
                                <Border Background="White"
                                        BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10"
                                                          BlurRadius="12" ShadowDepth="3" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <ItemsPresenter Margin="0,2,0,2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            Margin="0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsHighlighted" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter search TextBox -->
        <Style x:Key="FilterSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="ph" Text="🔍 이름 검색" Foreground="#94A3B8"
                                           FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab header -->
        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="under" Height="3" CornerRadius="2" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" Background="Transparent" Margin="6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="under" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <Style x:Key="SmallAttachStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="BrokenDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cell center style -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 교육현황 표: 강조 셀 (실적/반기 합계) -->
        <Style x:Key="SummaryHighlightCell" TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>

        <!-- 교육현황 표: 월별 셀 (실적이 있는 월만 강조) -->
        <Style x:Key="MonthlyHighlightCell" TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 교육 기록: 교육일자 셀 / 편집 템플릿 -->
        <DataTemplate x:Key="TrainingDateCellTemplate">
            <TextBlock Text="{Binding TrainingDateShort}" Style="{StaticResource CenterCell}" Margin="10,0"/>
        </DataTemplate>
        <DataTemplate x:Key="TrainingDateEditTemplate">
            <DatePicker SelectedDate="{Binding TrainingDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" Margin="2,0"/>
        </DataTemplate>

        <!-- 교육 기록: 교육기록서 첨부 칩 -->
        <DataTemplate x:Key="TrainingDocCellTemplate">
            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                    DragOver="CellAttachment_DragOver"
                    DragLeave="CellAttachment_DragLeave"
                    Drop="CellDropTrainingRecord_Drop">
                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                        Background="#F1F5F9" Tag="{Binding}"
                        MouseLeftButtonUp="AttachChipTrainingRecord_Click"
                        MouseRightButtonUp="AttachChipTrainingRecord_RightClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="chipTxt" Text="{Binding DocumentLabel}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDocument}" Value="True">
                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 교육 기록: 교육이미지 첨부 칩 -->
        <DataTemplate x:Key="TrainingImageCellTemplate">
            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                    DragOver="CellAttachment_DragOver"
                    DragLeave="CellAttachment_DragLeave"
                    Drop="CellDropTrainingImage_Drop">
                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                        Background="#F1F5F9" Tag="{Binding}"
                        MouseLeftButtonUp="AttachChipTrainingImage_Click"
                        MouseRightButtonUp="AttachChipTrainingImage_RightClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="chipTxt" Text="{Binding ImageLabel}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="True">
                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 교육 기록: 교육 내용 셀 / 편집 템플릿 -->
        <DataTemplate x:Key="TrainingContentCellTemplate">
            <TextBlock Text="{Binding Content}" VerticalAlignment="Center" Margin="10,0"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="TrainingContentEditTemplate">
            <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="2,0" BorderThickness="0"
                     Background="Transparent" Padding="8,0"/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 대시보드 (월별 차트 + 팀/제품종류 현황) -->
        <Border x:Name="TopDashboardArea" Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="0">
            <Grid MinHeight="252">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <!-- 대시보드: 월별 제품군 수량 -->
                <Grid Grid.Column="0" Margin="22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDashTitle" Text="2026년 월별 제품군 수량"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRecordCount" Text="" FontSize="11"
                                   Foreground="#94A3B8" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                    </StackPanel>

                    <!-- 차트 (트랙 + 채움 막대) -->
                    <ItemsControl x:Name="ChartHost" Grid.Row="1" Margin="0,18,0,0"
                                  VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 합계 -->
                                    <TextBlock Grid.Row="0" Text="{Binding TotalLabel}" MinHeight="15"
                                               FontSize="11" Foreground="#1E293B" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>

                                    <!-- 막대: 트랙(연한 배경) 위에 색상 채움 -->
                                    <Grid Grid.Row="1" Height="150" Width="24"
                                          VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border CornerRadius="6" Background="#F1F5F9"/>
                                        <Border CornerRadius="6" ClipToBounds="True"
                                                VerticalAlignment="Bottom" SnapsToDevicePixels="True">
                                            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Color}"
                                                                Height="{Binding HeightPx}"
                                                                ToolTip="{Binding Tip}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>

                                    <!-- 월 -->
                                    <TextBlock Grid.Row="2" Text="{Binding MonthLabel}"
                                               FontSize="11" Foreground="#64748B"
                                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 범례 -->
                    <ItemsControl x:Name="LegendHost" Grid.Row="2" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="8,3" Margin="0,3,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#475569"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Fill="#E2E8F0" Margin="0,10"/>

                <!-- 팀별 / 제품종류별 현황 -->
                <Grid Grid.Column="2" Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 팀별 (제품군 누적) -->
                    <TextBlock Grid.Row="0" Text="팀별 · 제품군" FontSize="12" FontWeight="Bold"
                               Foreground="#334155" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <ItemsControl x:Name="TeamBreakdownHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                   Foreground="#475569" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 제품군별 누적 가로 막대 -->
                                        <Border Grid.Column="1" HorizontalAlignment="Left" Height="15"
                                                CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding Segments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Color}"
                                                                Width="{Binding Length}"
                                                                ToolTip="{Binding Tip}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#0F172A"
                                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 제품종류별 -->
                    <TextBlock Grid.Row="2" Text="제품종류별" FontSize="12" FontWeight="Bold"
                               Foreground="#334155" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TypeBreakdownHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                   Foreground="#475569" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}" Height="15"
                                                Background="{Binding Color}" CornerRadius="4"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#0F172A"
                                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- 대시보드 접기/펴기 토글 -->
        <Grid x:Name="DashboardToggleRow" Grid.Row="1" Margin="8,12,8,12">
            <Rectangle Height="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Center"/>
            <Button x:Name="BtnToggleDashboard" Content="대시보드 접기 ▲"
                    HorizontalAlignment="Center" Padding="24,6"
                    Background="#FFFFFF" Foreground="#64748B"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                    FontSize="13" FontWeight="Bold" Cursor="Hand"
                    Click="BtnToggleDashboard_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 탭 -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- Tab 1: Broken 현황 -->
            <TabItem Header="Broken 현황" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 필터 바 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="16,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="년도" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbYear" MinWidth="110" Margin="0,0,16,0"/>

                            <TextBlock Text="라인" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbLine" MinWidth="110" Margin="0,0,16,0"/>

                            <TextBlock Text="팀" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbTeam" MinWidth="110" Margin="0,0,16,0"/>

                            <TextBlock Text="제품종류" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbProductType" MinWidth="110" Margin="0,0,16,0"/>

                            <TextBlock Text="발생단계" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbOccurStage" MinWidth="110" Margin="0,0,16,0"/>

                            <TextBlock Text="유발자" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:MultiSelectFilter x:Name="CmbCauser" MinWidth="110" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtCauserSearch" Style="{StaticResource FilterSearchBoxStyle}"
                                     TextChanged="CauserSearch_TextChanged" Margin="0,0,16,0"/>

                            <Button Content="초기화" Style="{StaticResource GhostButtonStyle}"
                                    Click="BtnResetFilter_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- 툴바 -->
                    <StackPanel x:Name="BrokenToolbar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnLoadFile" Content="파일 불러오기" Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30" Margin="0,0,6,0"
                                Click="BtnLoadFile_Click"/>
                        <Button x:Name="BtnAddRow" Content="+ 행 추가" Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30" Margin="0,0,6,0"
                                Click="BtnAddRow_Click"/>
                        <Button x:Name="BtnDeleteRow" Content="행 삭제" Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30" Margin="0,0,6,0"
                                Click="BtnDeleteRow_Click"/>
                        <Button x:Name="BtnSaveData" Content="저장" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30" Margin="0,0,6,0"
                                Click="BtnSave_Click"/>
                        <Button x:Name="BtnExportExcel" Content="엑셀 내보내기" Style="{StaticResource GhostButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30"
                                Click="BtnExportExcel_Click"/>
                    </StackPanel>

                    <!-- 데이터 그리드 -->
                    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="DgBroken"
                                  Style="{StaticResource BrokenDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  CanUserAddRows="False"
                                  CellEditEnding="DgBroken_CellEditEnding">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="NO" Binding="{Binding DisplayNo}" Width="50"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTemplateColumn Header="발생일" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OccurDateShort}" Style="{StaticResource CenterCell}" Margin="10,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding OccurDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        VerticalAlignment="Center" Margin="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="라인" Binding="{Binding Line}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="제품명" Binding="{Binding ProductName}" Width="3*" MinWidth="220"/>

                                <DataGridTextColumn Header="S/N" Binding="{Binding SN}" Width="175"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="팀" Binding="{Binding Team}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="유발자" Binding="{Binding Causer}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="직위 (경력)" Binding="{Binding PositionDisplay}"
                                                    Width="140" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="제품종류" Binding="{Binding ProductType}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <DataGridTextColumn Header="발생단계" Binding="{Binding OccurStage}" Width="90"
                                                    ElementStyle="{StaticResource CenterCell}"/>

                                <!-- ── 공식/비공식 ── -->
                                <DataGridTemplateColumn x:Name="ColIsOfficial" Header="공식여부" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="offBd" CornerRadius="6" Padding="8,3"
                                                    HorizontalAlignment="Center" Background="#F1F5F9">
                                                <TextBlock x:Name="offTxt" Text="{Binding IsOfficial}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOfficial}" Value="공식">
                                                    <Setter TargetName="offBd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="offTxt" Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding IsOfficial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Content" VerticalAlignment="Center" Margin="2,0">
                                                <ComboBoxItem Content="공식"/>
                                                <ComboBoxItem Content="비공식"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 경위서 ── -->
                                <DataGridTemplateColumn Header="경위서" Width="*" MinWidth="58" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropIncident_Drop">
                                                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                                                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                                                        Background="#F1F5F9" Tag="{Binding}"
                                                        MouseLeftButtonUp="AttachChipIncident_Click"
                                                        MouseRightButtonUp="AttachChipIncident_RightClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="chipTxt" Text="{Binding IncidentLabel}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasIncident}" Value="True">
                                                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 대책서 ── -->
                                <DataGridTemplateColumn Header="대책서" Width="*" MinWidth="58" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropCountermeasure_Drop">
                                                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                                                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                                                        Background="#F1F5F9" Tag="{Binding}"
                                                        MouseLeftButtonUp="AttachChipCountermeasure_Click"
                                                        MouseRightButtonUp="AttachChipCountermeasure_RightClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="chipTxt" Text="{Binding CountermeasureLabel}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasCountermeasure}" Value="True">
                                                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 교육서 ── -->
                                <DataGridTemplateColumn Header="교육서" Width="*" MinWidth="58" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropTraining_Drop">
                                                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                                                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                                                        Background="#F1F5F9" Tag="{Binding}"
                                                        MouseLeftButtonUp="AttachChipTraining_Click"
                                                        MouseRightButtonUp="AttachChipTraining_RightClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="chipTxt" Text="{Binding TrainingLabel}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasTraining}" Value="True">
                                                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ── 교육이미지 ── -->
                                <DataGridTemplateColumn Header="교육이미지" Width="*" MinWidth="58" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" AllowDrop="True" Tag="{Binding}"
                                                    DragOver="CellAttachment_DragOver"
                                                    DragLeave="CellAttachment_DragLeave"
                                                    Drop="CellDropTrainingImages_Drop">
                                                <Border x:Name="chipBd" CornerRadius="6" Padding="8,4"
                                                        HorizontalAlignment="Left" Margin="6,0" Cursor="Hand"
                                                        Background="#F1F5F9" Tag="{Binding}"
                                                        MouseLeftButtonUp="AttachChipTrainingImages_Click"
                                                        MouseRightButtonUp="AttachChipTrainingImages_RightClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock x:Name="chipTxt" Text="{Binding TrainingImageLabel}"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                                   VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasTrainingImage}" Value="True">
                                                    <Setter TargetName="chipBd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="chipTxt" Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: 교육 현황 -->
            <TabItem Header="교육 현황" Style="{StaticResource TabHeaderStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1) 교육 활동 실행률 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="1) 교육 활동 실행률" FontSize="14" FontWeight="Bold"
                                           Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <TextBlock Text="년도" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTrainingYear" Style="{StaticResource FilterComboStyle}"
                                          MinWidth="90" SelectionChanged="CmbTrainingYear_SelectionChanged"/>
                            </StackPanel>
                            <DataGrid x:Name="DgTrainingSummary"
                                      Style="{StaticResource BrokenDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      BeginningEdit="DgTrainingSummary_BeginningEdit"
                                      CellEditEnding="DgTrainingSummary_CellEditEnding">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="구분" Binding="{Binding CategoryLabel}" Width="150"
                                                         IsReadOnly="True" ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn x:Name="ColPrevYearActual" Header="25년 실적" Binding="{Binding Target2025}" Width="75"
                                                         ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn x:Name="ColCurYearTarget" Header="26년 목표" Binding="{Binding Target2026}" Width="75"
                                                         ElementStyle="{StaticResource CenterCell}"/>
                                    <DataGridTextColumn x:Name="ColCurYearActual" Header="26년 실적" Binding="{Binding Actual2026}" Width="75"
                                                         IsReadOnly="True" ElementStyle="{StaticResource SummaryHighlightCell}"/>
                                    <DataGridTextColumn Header="1월"  Binding="{Binding Monthly[0]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="2월"  Binding="{Binding Monthly[1]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="3월"  Binding="{Binding Monthly[2]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="4월"  Binding="{Binding Monthly[3]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="5월"  Binding="{Binding Monthly[4]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="6월"  Binding="{Binding Monthly[5]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="7월"  Binding="{Binding Monthly[6]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="8월"  Binding="{Binding Monthly[7]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="9월"  Binding="{Binding Monthly[8]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="10월" Binding="{Binding Monthly[9]}"  Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="11월" Binding="{Binding Monthly[10]}" Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="12월" Binding="{Binding Monthly[11]}" Width="45" IsReadOnly="True" ElementStyle="{StaticResource MonthlyHighlightCell}"/>
                                    <DataGridTextColumn Header="상반기" Binding="{Binding FirstHalf}"  Width="70" IsReadOnly="True" ElementStyle="{StaticResource SummaryHighlightCell}"/>
                                    <DataGridTextColumn Header="하반기" Binding="{Binding SecondHalf}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource SummaryHighlightCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 2) 교육 기록 - 헤더 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="2) 교육 기록" FontSize="14" FontWeight="Bold"
                                   Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="BtnSaveTraining" Content="저장" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6" FontSize="12" Height="30"
                                Click="BtnSaveTraining_Click"/>
                    </StackPanel>

                    <!-- 2) 교육 기록 - 생산 / 물류 분리 리스트 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 생산 -->
                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                                    <TextBlock Text="생산" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnAddTrainingRowProd" Content="+ 행 추가" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Height="28" Margin="0,0,6,0"
                                            Click="BtnAddTrainingRowProd_Click"/>
                                    <Button x:Name="BtnDeleteTrainingRowProd" Content="행 삭제" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Height="28"
                                            Click="BtnDeleteTrainingRowProd_Click"/>
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,0,0,8">
                                <DataGrid x:Name="DgTrainingProd"
                                          Style="{StaticResource BrokenDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          CanUserAddRows="False"
                                          CellEditEnding="DgTrainingRecord_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding DisplayNo}" Width="50"
                                                             IsReadOnly="True" ElementStyle="{StaticResource CenterCell}"/>
                                        <DataGridTemplateColumn Header="교육일자" Width="150"
                                                                 CellTemplate="{StaticResource TrainingDateCellTemplate}"
                                                                 CellEditingTemplate="{StaticResource TrainingDateEditTemplate}"/>
                                        <DataGridTemplateColumn Header="교육 내용" Width="*"
                                                                 CellTemplate="{StaticResource TrainingContentCellTemplate}"
                                                                 CellEditingTemplate="{StaticResource TrainingContentEditTemplate}"/>
                                        <DataGridTemplateColumn Header="교육기록서" Width="120" MinWidth="58" IsReadOnly="True"
                                                                 CellTemplate="{StaticResource TrainingDocCellTemplate}"/>
                                        <DataGridTemplateColumn Header="교육이미지" Width="120" MinWidth="58" IsReadOnly="True"
                                                                 CellTemplate="{StaticResource TrainingImageCellTemplate}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 물류 -->
                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                                    <TextBlock Text="물류" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnAddTrainingRowLogi" Content="+ 행 추가" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Height="28" Margin="0,0,6,0"
                                            Click="BtnAddTrainingRowLogi_Click"/>
                                    <Button x:Name="BtnDeleteTrainingRowLogi" Content="행 삭제" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Height="28"
                                            Click="BtnDeleteTrainingRowLogi_Click"/>
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,0,0,8">
                                <DataGrid x:Name="DgTrainingLogi"
                                          Style="{StaticResource BrokenDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          CanUserAddRows="False"
                                          CellEditEnding="DgTrainingRecord_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO" Binding="{Binding DisplayNo}" Width="50"
                                                             IsReadOnly="True" ElementStyle="{StaticResource CenterCell}"/>
                                        <DataGridTemplateColumn Header="교육일자" Width="150"
                                                                 CellTemplate="{StaticResource TrainingDateCellTemplate}"
                                                                 CellEditingTemplate="{StaticResource TrainingDateEditTemplate}"/>
                                        <DataGridTemplateColumn Header="교육 내용" Width="*"
                                                                 CellTemplate="{StaticResource TrainingContentCellTemplate}"
                                                                 CellEditingTemplate="{StaticResource TrainingContentEditTemplate}"/>
                                        <DataGridTemplateColumn Header="교육기록서" Width="120" MinWidth="58" IsReadOnly="True"
                                                                 CellTemplate="{StaticResource TrainingDocCellTemplate}"/>
                                        <DataGridTemplateColumn Header="교육이미지" Width="120" MinWidth="58" IsReadOnly="True"
                                                                 CellTemplate="{StaticResource TrainingImageCellTemplate}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
