<UserControl x:Class="CleanPotal.DispatchCertificateBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" Loaded="UserControl_Loaded"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True" UseLayoutRounding="True">

    <UserControl.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="0,2,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CBD5E1" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolidDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridTextBlock" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 요약 칩 스타일 -->
        <Style x:Key="SummaryChip" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="반출등록 성적서 생성" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="반출등록 시트 데이터를 기준으로 템플릿 성적서를 수량만큼 자동 생성하고 생성이력을 기록합니다." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="⬇  세정 의뢰 양식" Height="36" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnDownloadRequestForm_Click"/>
                <Button Content="초기화" Height="36" Width="80" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnReset_Click"/>
                <Button Content="생성이력 조회" Height="36" Style="{StaticResource SecondaryButton}" Click="BtnShowHistory_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── 드롭 존 ── -->
        <Grid Grid.Row="2">
            <!-- 대시 테두리 효과 -->
            <Rectangle StrokeDashArray="6,3" Stroke="#BFDBFE" StrokeThickness="2" RadiusX="10" RadiusY="10"/>
            <Border x:Name="AetsFilePanel" Background="#F0F7FF" CornerRadius="10" Margin="1"
                    Height="160" AllowDrop="True"
                    PreviewDragOver="AetsPanel_PreviewDragOver" Drop="AetsPanel_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F0F7FF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="☁" FontSize="32" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="이곳에 고객사 세정 의뢰 양식(.xlsx, .xltx)을 끌어다 놓으세요"
                               FontWeight="SemiBold" FontSize="15" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtAetsStatus" Text="파일을 놓으면 즉시 분석을 시작합니다."
                               FontSize="13" Foreground="#60A5FA" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── 반출 정보 요약 ── -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="20,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="반출 정보 요약" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>

                <!-- 요약 칩 목록 -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal">

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="업체명  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryCompany" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="담당자  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryManager" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="품목명  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryPartName" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔢  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="총 수량  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryTotalQty" Text="-" Foreground="#2563EB" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="사용 공정  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryProcess" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="제품 상태  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryStatus" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅  " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="반출일  " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryDate" Text="-" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 실행 버튼 ── -->
        <Grid Grid.Row="6">
            <Button x:Name="BtnRun" Content="✦  성적서 자동 생성 실행" Height="44"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Click="BtnRun_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#2563EB" Opacity="0.3" BlurRadius="12" ShadowDepth="3" Direction="270"/>
                </Button.Effect>
            </Button>
        </Grid>

        <!-- ── 결과 그리드 ── -->
        <Border Grid.Row="8" CornerRadius="10" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 그리드 헤더 -->
                <Border Grid.Row="0" Background="#1E293B" Padding="18,12" CornerRadius="10,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#334155" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="결과 목록" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="데이터 검증 및 처리 결과 통합 목록" FontWeight="SemiBold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="AetsPreviewGrid" Grid.Row="1" Style="{StaticResource SolidDataGridStyle}" MaxHeight="440">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="선택" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="구분" Binding="{Binding ProductCode}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlock}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#059669"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="품목명" Binding="{Binding PartName}" Width="170" ElementStyle="{StaticResource GridTextBlock}"/>

                        <DataGridTextColumn Header="도면명" Binding="{Binding ItemCode}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlock}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="수량" Binding="{Binding Qty}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextBlock}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="성공">
                                            <Setter Property="Foreground" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="실패">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="대기">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="처리중...">
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="처리 상세 메시지" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource GridTextBlock}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── 생성이력 오버레이 ── -->
        <Border x:Name="HistoryOverlay" Grid.RowSpan="9" Background="#88000000" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="White" Width="1020" Height="660" CornerRadius="12" Padding="28"
                    BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="30" ShadowDepth="8" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="성적서 생성이력 조회" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="자동 생성된 성적서의 전체 이력을 확인합니다." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="✕  닫기" Width="90" Height="36" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnCloseHistory_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Height="36" Margin="0,0,10,0">
                                <Grid Width="220">
                                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13"/>
                                    <TextBox x:Name="TxtHistorySearch" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Margin="30,0,8,0" FontSize="13" TextChanged="TxtHistorySearch_TextChanged"/>
                                </Grid>
                            </Border>
                            <Button Content="새로고침" Height="36" Style="{StaticResource SecondaryButton}" Click="BtnRefreshHistory_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" CornerRadius="8" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid x:Name="HistoryGrid" Style="{StaticResource SolidDataGridStyle}">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="생성일시"  Binding="{Binding CreateDate}"   Width="150" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="등록번호"  Binding="{Binding RegNo}"        Width="160" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="업체명"   Binding="{Binding CompanyName}"  Width="120" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="제품구분"  Binding="{Binding ProductType}"  Width="100" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="품목명"   Binding="{Binding PartName}"     Width="180" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="수량"     Binding="{Binding Qty}"          Width="60"  ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="담당자"   Binding="{Binding ManagerName}"  Width="100" ElementStyle="{StaticResource GridTextBlock}"/>
                                <DataGridTextColumn Header="저장경로"  Binding="{Binding SavePath}"     Width="*"   ElementStyle="{StaticResource GridTextBlock}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
