<UserControl x:Class="CleanPotal.AiDocSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 왼쪽: 설정 + 문서 목록 ========== -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AI 모델 설정 (로컬 Ollama) -->
                <TextBlock Grid.Row="0" Text="AI 모델 설정 (로컬 Ollama)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Ollama 서버 주소" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtOllamaEndpoint" FontSize="12" Padding="8,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"/>

                        <TextBlock Text="모델 이름" FontSize="11" Foreground="#64748B" Margin="0,10,0,4"/>
                        <ComboBox x:Name="CmbModel" FontSize="12" Padding="8,6" IsEditable="True">
                            <ComboBoxItem Content="llama3.2:3b"/>
                            <ComboBoxItem Content="qwen2.5:3b"/>
                            <ComboBoxItem Content="llama3.1:8b"/>
                            <ComboBoxItem Content="qwen2.5:7b"/>
                            <ComboBoxItem Content="gemma2:9b"/>
                            <ComboBoxItem Content="mistral:7b"/>
                        </ComboBox>

                        <Button Content="설정 저장" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="BtnSaveSettings_Click"/>
                        <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="11" Foreground="#16A34A" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="※ 이 PC(또는 같은 네트워크의 PC)에 Ollama가 설치/실행 중이어야 합니다." FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="※ 응답이 너무 느리면 llama3.2:3b / qwen2.5:3b 같은 작은 모델이 훨씬 빠릅니다 (ollama pull 모델명 으로 먼저 다운로드 필요)." FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 문서 목록 헤더 -->
                <Grid Grid.Row="2" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="참고 문서 목록" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDocCount" Grid.Column="1" Text="0개" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>

                <!-- 업로드 버튼 -->
                <Button Grid.Row="3" Content="+ 문서 업로드 (xlsx / pdf / txt)" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,10" Click="BtnUploadDoc_Click"/>

                <!-- 문서 목록 -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DocListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SummaryInfo}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="삭제" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="11" Click="BtnDeleteDoc_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== 오른쪽: 채팅 영역 ========== -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 바 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AI 문서 검색" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    <TextBlock Text="업로드한 기준서/문서를 기반으로 로컬 AI(Ollama)에게 질문할 수 있습니다." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="대화 초기화" Style="{StaticResource GhostButtonStyle}" Click="BtnClearChat_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 채팅 메시지 영역 -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl x:Name="ChatListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Border Background="{Binding BubbleBackground}"
                                            BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10"
                                            Padding="12,8"
                                            HorizontalAlignment="{Binding BubbleAlignment}"
                                            MaxWidth="640">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 입력 영역 -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Margin="0,0,8,0">
                    <TextBox x:Name="TxtQuestion" Background="Transparent" BorderThickness="0" Padding="12,10" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                             TextOptions.TextFormattingMode="Ideal"
                             SpellCheck.IsEnabled="False" PreviewKeyDown="TxtQuestion_PreviewKeyDown"/>
                </Border>
                <Button x:Name="BtnSend" Grid.Column="1" Content="전송" Style="{StaticResource PrimaryButtonStyle}" Width="80" Click="BtnSend_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
