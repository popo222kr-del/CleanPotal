<UserControl x:Class="CleanPotal.MultiSelectFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34" MinWidth="120">
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" Focusable="False"
                      Background="White" BorderBrush="#CBD5E1"
                      HorizontalContentAlignment="Stretch">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>

            <!-- Content (logical tree, accessible by name) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DisplayText" Grid.Column="0" Text="전체"
                           Margin="10,0,4,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="#1E293B"
                           TextTrimming="CharacterEllipsis"/>
                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0"
                      Stroke="#64748B" StrokeThickness="1.5" Fill="Transparent"
                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </ToggleButton>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="6" MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                    Margin="0,3,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12"
                                      ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <StackPanel Margin="0,4">
                    <CheckBox x:Name="ChkAll" Content="전체" Margin="12,5" FontSize="13"
                              Foreground="#1E293B" FontWeight="SemiBold"
                              Click="ChkAll_Click"/>
                    <Border Height="1" Background="#E2E8F0" Margin="8,2"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="12,5" FontSize="13" Foreground="#1E293B"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
