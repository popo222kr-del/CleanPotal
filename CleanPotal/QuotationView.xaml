<UserControl x:Class="CleanPotal.QuotationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanPotal"
             Background="#F8FAFC"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox" BasedOn="{StaticResource MacInputTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LineItemCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="CellEditStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 업체 목록 ── -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 + 검색 -->
                <Border Grid.Row="0" Padding="14,16,14,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="업체 목록" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <TextBox x:Name="VendorSearchBox"
                                 Text="{Binding VendorSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MacInputTextBoxStyle}"
                                 Height="36" FontSize="13"
                                 Tag="업체명 검색..."/>
                    </StackPanel>
                </Border>

                <!-- 업체 리스트 -->
                <ListBox Grid.Row="1" x:Name="VendorListBox"
                         BorderThickness="0" Background="Transparent" Padding="8,8,8,0"
                         ItemsSource="{Binding FilteredVendors}"
                         ItemContainerStyle="{StaticResource ListItemStyle}"
                         SelectionChanged="VendorListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VendorName}" FontSize="14" FontWeight="Bold"
                                               Foreground="#1E293B" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- 즐겨찾기 토글 버튼 -->
                                <Button Grid.Column="1" Width="28" Height="28" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                        ToolTip="즐겨찾기" Click="BtnToggleFavorite_Click">
                                    <TextBlock FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="☆"/>
                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="★"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ── 오른쪽: 편집 영역 ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 툴바 -->
            <Border Grid.Row="0" Background="White" Padding="20,14,24,14"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 왼쪽: 뒤로가기 버튼 + 타이틀 + 수정자 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="← 목록" Style="{StaticResource MacSecondaryButtonStyle}"
                                Height="38" MinWidth="90" Margin="0,0,12,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="BtnBackToList_Click"/>
                        <TextBlock Text="{Binding ToolbarTitle}" FontSize="18" FontWeight="ExtraBold"
                                   Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding QuotationModifyInfo}"
                                   FontSize="11" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- 오른쪽: 액션 버튼들 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 폴더 가져오기: 비활성화 -->
                        <!--
                        <Button Content="📁 폴더 가져오기" Style="{StaticResource MacSecondaryButtonStyle}"
                                Height="38" MinWidth="130"
                                Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="BtnImportFolder_Click"/>
                        -->
                        <!-- 목록 화면: + 새 견적서만 표시 -->
                        <Button Content="+ 새 견적서" Style="{StaticResource MacPrimaryButtonStyle}"
                                Height="38" MinWidth="110"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsEnabled="{Binding HasSelectedVendor}"
                                Click="BtnNewQuotation_Click"/>
                        <!-- 편집 화면: 내보내기 + 저장만 표시 -->
                        <Button Content="엑셀 내보내기" Style="{StaticResource MacSecondaryButtonStyle}"
                                Height="38" MinWidth="120"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="BtnExportExcel_Click"/>
                        <Button Content="PDF 내보내기" Style="{StaticResource MacSecondaryButtonStyle}"
                                Height="38" MinWidth="120" Margin="10,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="BtnExportPdf_Click"/>
                        <Button Content="저장" Style="{StaticResource MacPrimaryButtonStyle}"
                                Height="38" MinWidth="90" Margin="10,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 뷰 상태 1: 업체 미선택 ── -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsNoneView, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="왼쪽에서 업체를 선택하세요."
                           FontSize="15" Foreground="#94A3B8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- ── 뷰 상태 2: 견적 목록 ── -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 건수 표시 -->
                <Border Grid.Row="0" Padding="28,16,28,0">
                    <TextBlock FontSize="13" Foreground="#64748B">
                        <Run Text="총 "/>
                        <Run Text="{Binding VendorQuotations.Count, Mode=OneWay}"/>
                        <Run Text="건"/>
                    </TextBlock>
                </Border>

                <!-- 견적 목록 그리드 -->
                <DataGrid Grid.Row="1" x:Name="VendorQuotationsGrid"
                          ItemsSource="{Binding VendorQuotations}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MinRowHeight="44"
                          BorderThickness="0"
                          BorderBrush="#E2E8F0"
                          Background="Transparent"
                          AlternationCount="2"
                          RowStyle="{StaticResource GridRowStyle}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          CellStyle="{StaticResource GridCellStyle}"
                          Margin="28,12,28,28"
                          MouseDoubleClick="QuotationListGrid_DoubleClick">
                    <DataGrid.Columns>
                        <!-- 견적번호 -->
                        <DataGridTextColumn Header="견적번호" Binding="{Binding QuoteNo}" IsReadOnly="True" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 견적일 -->
                        <DataGridTextColumn Header="견적일" Binding="{Binding Date}" IsReadOnly="True" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 담당자 -->
                        <DataGridTextColumn Header="담당자" Binding="{Binding Attention}" IsReadOnly="True" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 연락처 -->
                        <DataGridTextColumn Header="연락처" Binding="{Binding Phone}" IsReadOnly="True" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 총 수량 -->
                        <DataGridTextColumn Header="총 수량" Binding="{Binding TotalQty}" IsReadOnly="True" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 합계금액 -->
                        <DataGridTextColumn Header="합계금액" Binding="{Binding TotalAmount, StringFormat={}{0:#,##0}}" IsReadOnly="True" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="10,0,14,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 비고 -->
                        <DataGridTemplateColumn Header="비고" Width="*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Memo}" Style="{StaticResource CellTextStyle}"
                                               Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="8,0"
                                               MouseLeftButtonDown="MemoCell_MouseLeftButtonDown"
                                               MouseLeftButtonUp="MemoCell_MouseLeftButtonUp"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellEditStyle}" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- 관리 -->
                        <DataGridTemplateColumn Header="관리" Width="148" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0">
                                        <Button Content="편집" Style="{StaticResource MacSecondaryButtonStyle}"
                                                Height="32" MinWidth="60"
                                                DataContext="{Binding}"
                                                Click="BtnEditQuotation_Click"/>
                                        <Button Content="삭제" Style="{StaticResource MacDangerButtonStyle}"
                                                Height="32" MinWidth="60" Margin="6,0,0,0"
                                                DataContext="{Binding}"
                                                Click="BtnDeleteQuotationInList_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ── 뷰 상태 3: 폼 편집기 ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel x:Name="FormPanel" Margin="28,24,28,28"
                            DataContext="{Binding CurrentQuotation, RelativeSource={RelativeSource AncestorType=local:QuotationView}}">

                    <!-- ── 고객사 / 견적 정보 카드 ── -->
                    <Border Style="{StaticResource CardStyle}" Padding="24,20">
                        <Border.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MacInputTextBoxStyle}">
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontFamily" Value="Malgun Gothic"/>
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ── 고객사 정보 (왼쪽) ── -->
                            <Grid Grid.Column="0" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 견적번호 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quote No. (견적번호)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding QuoteNo, Mode=OneWay}"
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- R(F)Q No -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="R(F)Q No" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding RfqNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- 회사명 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Company (회사명)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Company, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- 담당자 -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Attention (담당자)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <Grid Grid.Row="6" Grid.Column="1">
                                    <TextBox x:Name="AttentionTextBox"
                                             Text="{Binding Attention, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="AttentionTextBox_GotFocus"
                                             TextChanged="AttentionTextBox_TextChanged"
                                             LostFocus="AttentionTextBox_LostFocus"
                                             Height="42" FontSize="14" Padding="10,0"
                                             BorderBrush="#E2E8F0" BorderThickness="1"
                                             VerticalContentAlignment="Center"/>
                                    <Popup x:Name="AttentionPopup"
                                           PlacementTarget="{Binding ElementName=AttentionTextBox}"
                                           Placement="Bottom"
                                           StaysOpen="True"
                                           MinWidth="{Binding ActualWidth, ElementName=AttentionTextBox}">
                                        <Border Background="White"
                                                BorderBrush="#CBD5E1" BorderThickness="1"
                                                CornerRadius="8" Padding="4">
                                            <ListBox x:Name="AttentionSuggestionList"
                                                     BorderThickness="0" Background="Transparent"
                                                     MaxHeight="200"
                                                     PreviewMouseLeftButtonDown="AttentionSuggestionList_PreviewMouseDown">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="10,7"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ManagerName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                            <TextBlock Text=" · " FontSize="13" Foreground="#94A3B8"/>
                                                            <TextBlock Text="{Binding ContactNumber}" FontSize="13" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- 연락처 -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Phone (연락처)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="8" Grid.Column="1"
                                         Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 구분선 -->
                            <Border Grid.Column="1" Background="#E2E8F0"/>

                            <!-- ── 견적 정보 (오른쪽) ── -->
                            <Grid Grid.Column="2" Margin="20,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 견적일 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date (견적일)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Date, Mode=OneWay}"
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- 유효기간 (자동: 견적일 +7일) -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Valid Until (유효일)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Validity, Mode=OneWay}"
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- AETS 담당자 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Our Contact (담당자)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding AetsManager, Mode=OneWay}"
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- AETS 연락처 -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone (연락처)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding AetsPhone, Mode=OneWay}"
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>

                                <!-- 사업자번호 -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Biz. No. (사업자번호)" Style="{StaticResource InlineLabelStyle}" TextWrapping="Wrap"/>
                                <Grid Grid.Row="8" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BusinessNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="기본값 저장"
                                            Style="{StaticResource MacSecondaryButtonStyle}"
                                            Height="42" MinWidth="100" Margin="8,0,0,0"
                                            Click="BtnSaveBusinessNo_Click"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── 견적 품목 카드 ── -->
                    <Border x:Name="LineItemsCard" Style="{StaticResource CardStyle}" Padding="24,20,24,0"
                            AllowDrop="True" DragOver="LineItemsCard_DragOver" Drop="LineItemsCard_Drop"
                            DragEnter="LineItemsCard_DragEnter" DragLeave="LineItemsCard_DragLeave">
                        <StackPanel>
                            <!-- 카드 헤더 -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="견적 품목" FontSize="13" FontWeight="Bold"
                                           Foreground="#475569" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📂 엑셀 가져오기" Style="{StaticResource MacSecondaryButtonStyle}"
                                            Height="36" MinWidth="120" Click="BtnImportExcel_Click"/>
                                    <Button Content="단가에서 추가" Style="{StaticResource MacSecondaryButtonStyle}"
                                            Height="36" MinWidth="110" Margin="8,0,0,0" Click="BtnInsertFromMasterInline_Click"/>
                                    <Button Content="+ 행 추가" Style="{StaticResource MacSecondaryButtonStyle}"
                                            Height="36" MinWidth="90" Margin="8,0,0,0" Click="BtnAddLineItem_Click"/>
                                    <Button Content="선택 삭제" Style="{StaticResource MacDangerButtonStyle}"
                                            Height="36" MinWidth="90" Margin="8,0,0,0" Click="BtnDeleteLineItem_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 품목 그리드 -->
                            <DataGrid x:Name="LineItemsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      MinRowHeight="42"
                                      BorderThickness="1"
                                      BorderBrush="#E2E8F0"
                                      Background="Transparent"
                                      AlternationCount="2"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      CellStyle="{StaticResource LineItemCellStyle}"
                                      PreparingCellForEdit="LineItemsGrid_PreparingCellForEdit"
                                      PreviewKeyDown="LineItemsGrid_PreviewKeyDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="LineItemRow_PreviewMouseLeftButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- No -->
                                    <DataGridTextColumn Header="No" Binding="{Binding No}" IsReadOnly="True" Width="46">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Part's Name -->
                                    <DataGridTemplateColumn Header="Part's Name" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource CellTextStyle}" TextWrapping="Wrap"
                                                           />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CellEditStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 품목코드 -->
                                    <DataGridTemplateColumn Header="품목코드" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PartCode}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"
                                                           />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PartCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 규격(SIZE) -->
                                    <DataGridTemplateColumn Header="규격 (SIZE)" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StandardSpec}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"
                                                           />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding StandardSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Q'ty -->
                                    <DataGridTemplateColumn Header="Q'ty" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Qty}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"
                                                           />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 단가 -->
                                    <DataGridTemplateColumn Header="단가 (₩)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ListPrice, StringFormat={}{0:N0}}"
                                                           Style="{StaticResource CellTextStyle}" HorizontalAlignment="Right" Padding="10,0,14,0"
                                                           />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ListPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CellEditStyle}" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 금액 (자동계산, 읽기전용) -->
                                    <DataGridTemplateColumn Header="금액 (₩)" Width="140" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}"
                                                           Style="{StaticResource CellTextStyle}"
                                                           HorizontalAlignment="Right" Padding="10,0,14,0"
                                                           FontWeight="SemiBold" Foreground="#1E40AF"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 합계 행 -->
                            <Border Background="#EFF6FF" Padding="20,14"
                                    BorderBrush="#BFDBFE" BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,8,8" Margin="0,0,0,0">
                                <Grid>
                                    <TextBlock Text="합계 (Total)" FontSize="14" FontWeight="Bold"
                                               Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="수량  " FontSize="13" Foreground="#3B82F6" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalQty, RelativeSource={RelativeSource AncestorType=local:QuotationView}}"
                                                   FontSize="14" Foreground="#1D4ED8" FontWeight="Bold" Margin="0,0,32,0"/>
                                        <TextBlock Text="금액  " FontSize="13" Foreground="#3B82F6" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TotalAmount, RelativeSource={RelativeSource AncestorType=local:QuotationView}, StringFormat={}{0:N0}}"
                                                   FontSize="15" Foreground="#1D4ED8" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Height="24" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- ── 비고 카드 ── -->
                    <Border Style="{StaticResource CardStyle}" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="비고 (Remarks)" FontSize="13" FontWeight="Bold"
                                       Foreground="#475569" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                     Padding="12" BorderBrush="#E2E8F0" BorderThickness="1"
                                     FontSize="14" VerticalScrollBarVisibility="Auto"
                                     LostFocus="RemarksTextBox_LostFocus"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── 단가 관리 모달 ── -->
        <Grid x:Name="ProductMasterOverlay" Grid.ColumnSpan="2"
              Background="#CC000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16"
                    Width="920" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="Black" Opacity="0.2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 타이틀 + 액션 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="단가 관리" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="제품 단가를 등록하면 견적서 작성 시 빠르게 추가할 수 있습니다."
                                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 관리자(1004)만 삭제 가능 -->
                            <Button Content="선택 삭제" Style="{StaticResource MacDangerButtonStyle}"
                                    Height="36" MinWidth="90" Margin="0,0,8,0"
                                    Visibility="{Binding IsQuotationAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="BtnDeleteMasterItem_Click"/>
                            <Button Content="+ 항목 추가" Style="{StaticResource MacSecondaryButtonStyle}"
                                    Height="36" MinWidth="100" Margin="0,0,8,0" Click="BtnAddMasterItem_Click"/>
                            <Button Content="견적에 추가" Style="{StaticResource MacPrimaryButtonStyle}"
                                    Height="36" MinWidth="100" Click="BtnInsertFromMasterModal_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: 업체 칩 필터 (Notion 스타일) -->
                    <Border Grid.Row="1" Margin="0,0,0,12"
                            Background="#F8FAFC" CornerRadius="10" Padding="10,8">
                        <ListBox ItemsSource="{Binding MasterVendorOptions}"
                                 SelectedItem="{Binding MasterVendorFilter, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="3,3"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="20" Padding="12,5"
                                                        Background="#EFF1F5" Cursor="Hand">
                                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#64748B"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                                        <Setter TargetName="Txt" Property="Foreground" Value="#1D4ED8"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- Row 2: 검색 박스 -->
                    <Border Grid.Row="2" Margin="0,0,0,12"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="38">
                        <Grid>
                            <TextBlock Text="🔍" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding MasterSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     Foreground="#1E293B" Padding="24,0,0,0"
                                     Tag="품목코드 또는 제품명 검색..."/>
                        </Grid>
                    </Border>

                    <!-- Row 3: 단가 그리드 -->
                    <DataGrid Grid.Row="3" x:Name="ProductMasterGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinRowHeight="42"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              Background="Transparent"
                              AlternationCount="2"
                              SelectionMode="Extended"
                              RowStyle="{StaticResource GridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              CellEditEnding="ProductMasterGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="업체" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VendorName}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding VendorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Part's Name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource CellTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CellEditStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="품목코드" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PartCode}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PartCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="규격 (SIZE)" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Spec}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Spec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CellEditStyle}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="단가 (₩) / 1EA" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                   Style="{StaticResource CellTextStyle}" HorizontalAlignment="Right"
                                                   Padding="10,0,14,0" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CellEditStyle}" TextAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 4: 모달 하단 -->
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="※ Ctrl/Shift 로 복수 선택 후 '견적에 추가'"
                                   FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="저장" Style="{StaticResource MacSecondaryButtonStyle}"
                                    Height="40" MinWidth="90" Margin="0,0,8,0"
                                    Click="BtnSaveProductMaster_Click"/>
                            <Button Content="닫기" Style="{StaticResource MacPrimaryButtonStyle}"
                                    Height="40" MinWidth="90"
                                    Click="BtnCloseProductMaster_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
