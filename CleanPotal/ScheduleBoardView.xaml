<UserControl x:Class="CleanPotal.ScheduleBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="ScheduleBoardView_Loaded"
             IsVisibleChanged="ScheduleBoardView_IsVisibleChanged"
             PreviewKeyDown="ScheduleBoardView_PreviewKeyDown"
             PreviewKeyUp="ScheduleBoardView_PreviewKeyUp"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F5F7FB">

    <UserControl.Resources>
        <Style x:Key="MacScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Margin="2,2,4,2" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                <Setter TargetName="ThumbBorder" Property="Margin" Value="2,2,2,4"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MacScrollThumbStyle}" Background="{TemplateBinding Foreground}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="StarText" Text="☆" FontSize="20" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarText" Property="Text" Value="★"/>
                                <Setter TargetName="StarText" Property="Foreground" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarText" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecipeItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="레시피 선택" FontWeight="ExtraBold" FontSize="16" Foreground="#111827" Margin="0,0,0,16"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecipeListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button x:Name="BtnPrevDay" Content="◀" FontSize="13" Width="30" Height="30" Click="BtnPrevDay_Click" Cursor="Hand" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TxtCurrentDate" Text="{Binding CurrentDateText}" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="4,0"/>
                        <Button x:Name="BtnNextDay" Content="▶" FontSize="13" Width="30" Height="30" Click="BtnNextDay_Click" Cursor="Hand" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0" Margin="4,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F5F9"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnToday" Content="오늘" FontSize="12" Height="28" Click="BtnToday_Click" Cursor="Hand" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="12,0" Margin="0,0,16,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1D4ED8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Background="#E2E8F0" CornerRadius="8" Padding="3" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="DayCheckBox" Checked="DayCheckBox_Checked" Unchecked="DayCheckBox_Unchecked" Cursor="Hand" Margin="0">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="pill" Background="Transparent" CornerRadius="6" Padding="12,6" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="label" Text="주간" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="timeText" Text=" 07:00~19:00" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="#2563EB"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="timeText" Property="Foreground" Value="#BFDBFE"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="pill" Property="Background" Value="#CBD5E1"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                <CheckBox x:Name="NightCheckBox" Checked="NightCheckBox_Checked" Unchecked="NightCheckBox_Unchecked" Cursor="Hand" Margin="0">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="pill" Background="Transparent" CornerRadius="6" Padding="12,6" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="label" Text="야간" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="timeText" Text=" 19:00~06:00" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="#1E40AF"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="timeText" Property="Foreground" Value="#BFDBFE"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="pill" Property="Background" Value="#CBD5E1"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Zoom" Foreground="#4B5563" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="ZoomSlider" Width="120" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" Value="1.0" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                        <TextBlock x:Name="ZoomPercentText" Width="44" TextAlignment="Right" Foreground="#111827" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" x:Name="StatusTextBlock" Foreground="#4B5563" FontSize="12" Height="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>

            <Grid Grid.Row="2" x:Name="ContentGrid" Margin="0,0,0,16">
                <Border x:Name="RootCaptureTarget" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16"
                        VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, ElementName=ContentGrid}">
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Background="Black" CornerRadius="16" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Canvas x:Name="EquipmentHeaderCanvas" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True" Background="#F8FAFC"/>

                        <ScrollViewer x:Name="EquipmentScrollViewer" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" ScrollChanged="EquipmentScrollViewer_ScrollChanged" PreviewMouseWheel="AnyScroll_PreviewMouseWheel" CanContentScroll="False">
                            <Canvas x:Name="EquipmentCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" ScrollChanged="HeaderScrollViewer_ScrollChanged" PreviewMouseWheel="AnyScroll_PreviewMouseWheel" CanContentScroll="False" Background="#F8FAFC">
                            <Canvas x:Name="TimelineHeaderCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="BoardScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="BoardScrollViewer_ScrollChanged" PreviewMouseWheel="AnyScroll_PreviewMouseWheel" CanContentScroll="False" Focusable="True">
                            <Canvas x:Name="BoardContentCanvas" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Canvas x:Name="BoardGridCanvas" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                <Canvas x:Name="BoardBlocksCanvas" Background="Transparent" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                <Canvas x:Name="BoardInputLayer" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" MouseMove="BoardInputLayer_MouseMove" MouseLeave="BoardInputLayer_MouseLeave" MouseLeftButtonDown="BoardInputLayer_MouseLeftButtonDown" MouseRightButtonDown="BoardInputLayer_MouseRightButtonDown"/>
                            </Canvas>
                        </ScrollViewer>

                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>