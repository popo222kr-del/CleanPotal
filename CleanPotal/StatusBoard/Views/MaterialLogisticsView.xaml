<UserControl x:Class="CleanPotal.StatusBoard.Views.MaterialLogisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- ── Card ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Button ── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Nav Arrow Button ── -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── Vehicle Toggle Button ── -->
        <Style x:Key="VehicleToggle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- table (내용 크기에 맞춰 표·특이사항 사이 공백 제거) -->
            <RowDefinition Height="Auto"/>  <!-- special notes -->
            <RowDefinition Height="*"/>     <!-- 남는 공간은 맨 아래로 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 0: Toolbar                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8">
            <DockPanel>
                <!-- Right-side buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnAddRow" Content="+ 인원 추가" Style="{StaticResource GhostBtn}"
                            Margin="0,0,6,0" Click="BtnAddRow_Click"/>
                    <Button x:Name="BtnRemoveRow" Content="- 인원 삭제" Style="{StaticResource DangerBtn}"
                            Margin="0,0,12,0" Click="BtnRemoveRow_Click"/>
                    <Button x:Name="BtnSave" Content="저장" Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,6,0" Click="BtnSave_Click"/>
                    <Button x:Name="BtnPrint" Content="인쇄 (Excel)" Style="{StaticResource GhostBtn}"
                            Click="BtnPrint_Click"/>
                </StackPanel>

                <!-- Left-side date navigation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevDay" Content="◀" Style="{StaticResource NavBtn}"
                            Margin="0,0,4,0" Click="BtnPrevDay_Click"/>
                    <DatePicker x:Name="DpBoardDate" Width="140" FontSize="13"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="DpBoardDate_SelectedDateChanged"/>
                    <Button x:Name="BtnNextDay" Content="▶" Style="{StaticResource NavBtn}"
                            Margin="4,0,8,0" Click="BtnNextDay_Click"/>
                    <Button x:Name="BtnToday" Content="오늘" Style="{StaticResource GhostBtn}"
                            Click="BtnToday_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 1: Title Header                                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="천안사업장 자재 &amp; 물류 일정 현황"
                           FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtDate" FontSize="14" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 2: Main Schedule Table                                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                VerticalAlignment="Top">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          MaxHeight="640">
                <Grid x:Name="ScheduleGrid" Margin="0">
                    <!-- Columns defined in code-behind -->
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 3: Special Notes (오전/오후 분리)                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="특이사항" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 오전 -->
                    <StackPanel Grid.Column="0">
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <TextBlock Text="오전 (AM)" FontSize="13" FontWeight="Bold" Foreground="#1E40AF"/>
                        </Border>
                        <TextBox x:Name="TxtAmNotes" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" MaxHeight="160" FontSize="15" Foreground="#334155"
                                 BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- 오후 -->
                    <StackPanel Grid.Column="2">
                        <Border Background="#FED7AA" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <TextBlock Text="오후 (PM)" FontSize="13" FontWeight="Bold" Foreground="#9A3412"/>
                        </Border>
                        <TextBox x:Name="TxtPmNotes" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" MaxHeight="160" FontSize="15" Foreground="#334155"
                                 BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
