<UserControl x:Class="CleanPotal.StatusBoard.Views.MaterialLogisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- ── Card ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Button ── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Nav Arrow Button ── -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── Date Chevron (◀▶ 원형 플랫) ── -->
        <Style x:Key="DateChevron" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Date Pill (날짜 텍스트 클릭 → 달력) ── -->
        <Style x:Key="DatePillBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Vehicle Toggle Button ── -->
        <Style x:Key="VehicleToggle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- table (내용 크기에 맞춰 표·특이사항 사이 공백 제거) -->
            <RowDefinition Height="Auto"/>  <!-- special notes -->
            <RowDefinition Height="*"/>     <!-- 남는 공간은 맨 아래로 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 0: Toolbar                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8">
            <DockPanel>
                <!-- Right-side buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnManageMembers" Content="인원 관리" Style="{StaticResource GhostBtn}"
                            Margin="0,0,12,0" Click="BtnManageMembers_Click"/>
                    <Button x:Name="BtnSave" Content="저장" Style="{StaticResource PrimaryBtn}"
                            Click="BtnSave_Click"/>
                </StackPanel>

                <!-- Left-side date navigation (모던 달력) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                            Padding="3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPrevDay" Style="{StaticResource DateChevron}"
                                    Content="◀" Click="BtnPrevDay_Click" ToolTip="이전 날"/>
                            <Button x:Name="BtnDatePill" Style="{StaticResource DatePillBtn}" Click="BtnDatePill_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtDatePill" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" FontSize="11"
                                               Foreground="#94A3B8" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNextDay" Style="{StaticResource DateChevron}"
                                    Content="▶" Click="BtnNextDay_Click" ToolTip="다음 날"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnToday" Content="오늘" Style="{StaticResource GhostBtn}"
                            Click="BtnToday_Click"/>

                    <!-- 달력 팝업 -->
                    <Popup x:Name="CalPopup" PlacementTarget="{Binding ElementName=BtnDatePill}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="12" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.22" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Calendar x:Name="CalPicker" SelectedDatesChanged="CalPicker_SelectedDatesChanged"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1 (중복 대제목 제거됨 — 날짜는 상단 툴바 달력에 표시) -->

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 2: Main Schedule Table                                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                VerticalAlignment="Top">
            <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          MaxHeight="640" SizeChanged="TableScroll_SizeChanged">
                <Grid x:Name="ScheduleGrid" Margin="0">
                    <!-- Columns defined in code-behind -->
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 3: Special Notes (오전/오후 분리)                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="특이사항" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 오전=자재/물류(130)+AM영역, 오후=PM영역. 분할선(가운데 gap)이 위 표의 AM/PM 경계와 일치 -->
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 오전: 좌측 여백(자재/물류) + AM 영역 전체 -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <TextBlock Text="오전 (AM)" FontSize="13" FontWeight="Bold" Foreground="#1E40AF"/>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White">
                            <TextBox x:Name="TxtAmNotes" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="160" FontSize="15" Foreground="#334155"
                                     BorderThickness="0" Background="Transparent" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>

                    <!-- 오후 -->
                    <StackPanel Grid.Column="3">
                        <Border Background="#FED7AA" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <TextBlock Text="오후 (PM)" FontSize="13" FontWeight="Bold" Foreground="#9A3412"/>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White">
                            <TextBox x:Name="TxtPmNotes" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="160" FontSize="15" Foreground="#334155"
                                     BorderThickness="0" Background="Transparent" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
