<UserControl x:Class="CleanPotal.StatusBoard.Views.DongtanLogisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- ── Card ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Button ── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Nav Arrow Button ── -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── Section Title ── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ── Table Header Cell ── -->
        <Style x:Key="TblHeader" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>

        <!-- ── Table Data Cell ── -->
        <Style x:Key="TblCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- ── Editable TextBox inside table cells ── -->
        <Style x:Key="CellTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,4"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Number TextBox ── -->
        <Style x:Key="NumTextBox" TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>

        <!-- ── Header TextBlock ── -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Data Cell TextBlock (read-only display) ── -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Sum Row TextBlock ── -->
        <Style x:Key="SumText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="*"/>     <!-- content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 0: Toolbar                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8">
            <DockPanel>
                <!-- Right-side buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="저장" Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,6,0" Click="BtnSave_Click"/>
                    <Button x:Name="BtnPrint" Content="인쇄 (Excel)" Style="{StaticResource GhostBtn}"
                            Click="BtnPrint_Click"/>
                </StackPanel>

                <!-- Left-side date navigation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevDay" Content="&#x25C0;" Style="{StaticResource NavBtn}"
                            Margin="0,0,4,0" Click="BtnPrevDay_Click"/>
                    <DatePicker x:Name="DpBoardDate" Width="140" FontSize="13"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="DpBoardDate_SelectedDateChanged"/>
                    <Button x:Name="BtnNextDay" Content="&#x25B6;" Style="{StaticResource NavBtn}"
                            Margin="4,0,8,0" Click="BtnNextDay_Click"/>
                    <Button x:Name="BtnToday" Content="오늘" Style="{StaticResource GhostBtn}"
                            Click="BtnToday_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 1: Title Header                                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="동탄 물류 현황판"
                           FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtDate" FontSize="14" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Row 2: Main Content (ScrollViewer)                        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ════════════════════════════════════════════════ -->
                <!-- SECTION 1: 배차표 (Vehicle Dispatch Table)       -->
                <!-- ════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="배차표" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnAddGihwa" Content="+ 기흥/화성 추가" Style="{StaticResource GhostBtn}"
                                        Margin="0,0,6,0" Click="BtnAddGihwa_Click"/>
                                <Button x:Name="BtnAddPyeongtaek" Content="+ 평택 추가" Style="{StaticResource GhostBtn}"
                                        Margin="0,0,6,0" Click="BtnAddPyeongtaek_Click"/>
                                <Button x:Name="BtnRemoveDriver" Content="- 삭제" Style="{StaticResource DangerBtn}"
                                        Click="BtnRemoveDriver_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 기흥/화성 Group -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#DBEAFE" CornerRadius="8,8,0,0" Padding="10,8">
                                        <TextBlock Text="기흥 / 화성" FontSize="14" FontWeight="Bold"
                                                   Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Header Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="성명" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="차량" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="오전" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource TblHeader}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="오후" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                    </Grid>
                                    <ItemsControl x:Name="IcGihwa">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource TblCell}">
                                                        <TextBox Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource TblCell}" Background="{Binding VehicleBg}">
                                                        <TextBox Text="{Binding VehicleInfo, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource TblCell}">
                                                        <TextBox Text="{Binding AmRoute, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Style="{StaticResource TblCell}" BorderThickness="0,0,0,1">
                                                        <TextBox Text="{Binding PmRoute, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 평택 Group -->
                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#DCFCE7" CornerRadius="8,8,0,0" Padding="10,8">
                                        <TextBlock Text="평택" FontSize="14" FontWeight="Bold"
                                                   Foreground="#166534" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Header Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="성명" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="차량" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TblHeader}">
                                            <TextBlock Text="오전" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource TblHeader}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="오후" Style="{StaticResource HeaderText}"/>
                                        </Border>
                                    </Grid>
                                    <ItemsControl x:Name="IcPyeongtaek">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource TblCell}">
                                                        <TextBox Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource TblCell}" Background="{Binding VehicleBg}">
                                                        <TextBox Text="{Binding VehicleInfo, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource TblCell}">
                                                        <TextBox Text="{Binding AmRoute, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Style="{StaticResource TblCell}" BorderThickness="0,0,0,1">
                                                        <TextBox Text="{Binding PmRoute, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource CellTextBox}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════════ -->
                <!-- SECTION 2: 반입 수량 (Incoming Quantities)       -->
                <!-- ════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="반입 수량" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 오전 반입 -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#DBEAFE" CornerRadius="8,8,0,0" Padding="8,6">
                                        <TextBlock Text="오전 반입 수량" FontSize="13" FontWeight="Bold"
                                                   Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid x:Name="GridAmIn">
                                        <!-- Built in code-behind -->
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 오후 반입 -->
                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#FED7AA" CornerRadius="8,8,0,0" Padding="8,6">
                                        <TextBlock Text="오후 반입 수량" FontSize="13" FontWeight="Bold"
                                                   Foreground="#9A3412" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid x:Name="GridPmIn">
                                        <!-- Built in code-behind -->
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════════════ -->
                <!-- SECTION 3: 반출 물량 (Outgoing Quantities)       -->
                <!-- ════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="반출 물량" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 오전 반출 -->
                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#DBEAFE" CornerRadius="8,8,0,0" Padding="8,6">
                                        <TextBlock Text="오전 반출 물량" FontSize="13" FontWeight="Bold"
                                                   Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid x:Name="GridAmOut">
                                        <!-- Built in code-behind -->
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 오후 반출 -->
                            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Border Background="#FED7AA" CornerRadius="8,8,0,0" Padding="8,6">
                                        <TextBlock Text="오후 반출 물량" FontSize="13" FontWeight="Bold"
                                                   Foreground="#9A3412" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid x:Name="GridPmOut">
                                        <!-- Built in code-behind -->
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
