<UserControl x:Class="CleanPotal.StatusBoard.Views.ProductionBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- ── Card ── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ── Ghost Button ── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger Button ── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Packaging Cell TextBox ── -->
        <Style x:Key="PkgCell" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Packaging Header Cell (read-only label) ── -->
        <Style x:Key="PkgHeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ── Packaging Row Label ── -->
        <Style x:Key="PkgRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- ── Total Row Label ── -->
        <Style x:Key="TotalCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ── DataGrid (Team Roster) ── -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style x:Key="TeamHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">

                <!-- ══════════════ Toolbar ══════════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <DockPanel>
                        <TextBlock Text="생산 현황판" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="날짜" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="DpBoardDate" Width="140" VerticalAlignment="Center" FontSize="13"
                                        SelectedDateChanged="DpBoardDate_SelectedDateChanged"/>
                            <Button x:Name="BtnSave" Content="저장" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                                    Click="BtnSave_Click"/>
                            <Button x:Name="BtnPrint" Content="인쇄 (Excel)" Style="{StaticResource GhostBtn}" Margin="6,0,0,0"
                                    Click="BtnPrint_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ══════════════ Section 1: 포장 수량 ══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── 주간 포장 수량 ── -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="주간 포장 수량" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="차수:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TbDayRound" Width="60" FontSize="12" Text="1차"
                                                 Style="{StaticResource PkgCell}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Table Grid -->
                            <Grid x:Name="GridDay">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>  <!-- header -->
                                    <RowDefinition Height="36"/>  <!-- 기흥/화성 -->
                                    <RowDefinition Height="36"/>  <!-- 평택 -->
                                    <RowDefinition Height="36"/>  <!-- A급/부적합 -->
                                    <RowDefinition Height="36"/>  <!-- WOOAM -->
                                    <RowDefinition Height="36"/>  <!-- 기타 -->
                                    <RowDefinition Height="36"/>  <!-- 전산 (total) -->
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="구분" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="OUTER" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="INNER" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="BOAT" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="ACC" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>

                                <!-- Row 1: 기흥/화성 -->
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="기흥/화성" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="DayOuter0" Grid.Row="1" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayInner0" Grid.Row="1" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayBoat0"  Grid.Row="1" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayAcc0"   Grid.Row="1" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 2: 평택 -->
                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="평택" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="DayOuter1" Grid.Row="2" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayInner1" Grid.Row="2" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayBoat1"  Grid.Row="2" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayAcc1"   Grid.Row="2" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 3: A급/부적합 -->
                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="A급/부적합" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="DayOuter2" Grid.Row="3" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayInner2" Grid.Row="3" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayBoat2"  Grid.Row="3" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayAcc2"   Grid.Row="3" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 4: WOOAM -->
                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="WOOAM" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="DayOuter3" Grid.Row="4" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayInner3" Grid.Row="4" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayBoat3"  Grid.Row="4" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayAcc3"   Grid.Row="4" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 5: 기타 -->
                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="기타" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="DayOuter4" Grid.Row="5" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayInner4" Grid.Row="5" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayBoat4"  Grid.Row="5" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="DayAcc4"   Grid.Row="5" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 6: 전산 (totals) -->
                                <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0.5,0" Background="#F0F9FF">
                                    <TextBlock Text="전산:" Style="{StaticResource PkgRowLabel}" FontWeight="Bold" Foreground="#2563EB"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="DayTotalOuter" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="DayTotalInner" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="DayTotalBoat" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="4" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="DayTotalAcc" Style="{StaticResource TotalCell}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── 야간 포장 수량 ── -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#334155" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="야간 포장 수량" FontSize="14" FontWeight="Bold" Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="차수:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TbNightRound" Width="60" FontSize="12" Text="1차"
                                                 Style="{StaticResource PkgCell}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Table Grid -->
                            <Grid x:Name="GridNight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="구분" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="OUTER" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="INNER" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="BOAT" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                    <TextBlock Text="ACC" Style="{StaticResource PkgHeaderCell}" Foreground="#64748B"/>
                                </Border>

                                <!-- Row 1: 기흥/화성 -->
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="기흥/화성" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="NightOuter0" Grid.Row="1" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightInner0" Grid.Row="1" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightBoat0"  Grid.Row="1" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightAcc0"   Grid.Row="1" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 2: 평택 -->
                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="평택" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="NightOuter1" Grid.Row="2" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightInner1" Grid.Row="2" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightBoat1"  Grid.Row="2" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightAcc1"   Grid.Row="2" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 3: A급/부적합 -->
                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="A급/부적합" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="NightOuter2" Grid.Row="3" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightInner2" Grid.Row="3" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightBoat2"  Grid.Row="3" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightAcc2"   Grid.Row="3" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 4: WOOAM -->
                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="WOOAM" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="NightOuter3" Grid.Row="4" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightInner3" Grid.Row="4" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightBoat3"  Grid.Row="4" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightAcc3"   Grid.Row="4" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 5: 기타 -->
                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0.5,0.5">
                                    <TextBlock Text="기타" Style="{StaticResource PkgRowLabel}"/>
                                </Border>
                                <TextBox x:Name="NightOuter4" Grid.Row="5" Grid.Column="1" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightInner4" Grid.Row="5" Grid.Column="2" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightBoat4"  Grid.Row="5" Grid.Column="3" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>
                                <TextBox x:Name="NightAcc4"   Grid.Row="5" Grid.Column="4" Style="{StaticResource PkgCell}" TextChanged="PkgCell_TextChanged"/>

                                <!-- Row 6: 전산 (totals) -->
                                <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0.5,0" Background="#F0F9FF">
                                    <TextBlock Text="전산:" Style="{StaticResource PkgRowLabel}" FontWeight="Bold" Foreground="#2563EB"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="NightTotalOuter" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="NightTotalInner" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="NightTotalBoat" Style="{StaticResource TotalCell}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="4" Background="#F0F9FF" BorderBrush="#E2E8F0" BorderThickness="0,0.5,0,0">
                                    <TextBlock x:Name="NightTotalAcc" Style="{StaticResource TotalCell}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════════ Section 2: 팀 구성 ══════════════ -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── 장 팀 ── -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Background="#0F172A" CornerRadius="8" Padding="12,8" DockPanel.Dock="Top">
                                    <DockPanel>
                                        <TextBlock Text="장 팀" FontSize="14" FontWeight="Bold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button x:Name="BtnAddTeamA" Content="+ 추가" FontSize="11" Foreground="#93C5FD"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"
                                                    Click="BtnAddTeamA_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Cursor="Hand"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="BtnRemoveTeamA" Content="- 삭제" FontSize="11" Foreground="#FCA5A5"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="8,0,0,0"
                                                    Click="BtnRemoveTeamA_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Cursor="Hand"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                            <DataGrid x:Name="DgTeamA" Style="{StaticResource GridStyle}" ColumnHeaderStyle="{StaticResource TeamHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름" Binding="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" IsReadOnly="False"/>
                                    <DataGridTextColumn Header="경력" Binding="{Binding Experience, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="80" IsReadOnly="False"/>
                                    <DataGridTextColumn Header="연락처" Binding="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="140" IsReadOnly="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── 팀 ── -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Background="#0F172A" CornerRadius="8" Padding="12,8" DockPanel.Dock="Top">
                                    <DockPanel>
                                        <TextBlock Text="팀" FontSize="14" FontWeight="Bold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button x:Name="BtnAddTeamB" Content="+ 추가" FontSize="11" Foreground="#93C5FD"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"
                                                    Click="BtnAddTeamB_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Cursor="Hand"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="BtnRemoveTeamB" Content="- 삭제" FontSize="11" Foreground="#FCA5A5"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="8,0,0,0"
                                                    Click="BtnRemoveTeamB_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                                   FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Cursor="Hand"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                            <DataGrid x:Name="DgTeamB" Style="{StaticResource GridStyle}" ColumnHeaderStyle="{StaticResource TeamHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름" Binding="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" IsReadOnly="False"/>
                                    <DataGridTextColumn Header="경력" Binding="{Binding Experience, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="80" IsReadOnly="False"/>
                                    <DataGridTextColumn Header="연락처" Binding="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="140" IsReadOnly="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
