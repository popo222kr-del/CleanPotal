<UserControl x:Class="CleanPotal.EquipmentAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:CleanPotal"
             Background="#F9FAFB"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>

        <!-- ── Card ── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF0F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small label ── -->
        <Style x:Key="LblSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="14,0,6,0"/>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F9FAFB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <!-- ── Segmented control ── -->
        <Style x:Key="SegItem" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="#111827"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect BlurRadius="6" Opacity="0.10" ShadowDepth="1" Direction="270"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern ComboBox ── -->
        <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#F3F4F6"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="9">
                                            <TextBlock Text="▾" Foreground="#9CA3AF" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#C7D2FE"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="6">
                                    <Border.Effect><DropShadowEffect BlurRadius="14" Opacity="0.14" ShadowDepth="3" Direction="270"/></Border.Effect>
                                    <ScrollViewer MaxHeight="280" Margin="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Element chip ── -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="999" Padding="12,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F9FAFB"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Stat tile ── -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF0F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2" Direction="270"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#6B7280"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ── Calendar day button ── -->
        <Style x:Key="CalDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="#F3F4F6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalNav" TargetType="Button" BasedOn="{StaticResource CalDay}">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- ── DataGrid ── -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#EEF0F4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,14,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>            <!-- filter / actions -->
            <RowDefinition Height="Auto"/>            <!-- element chips -->
            <RowDefinition Height="Auto"/>            <!-- 요약 카드 -->
            <RowDefinition x:Name="RowChart" Height="*"/>  <!-- chart (접기 가능) -->
            <RowDefinition x:Name="RowTable" Height="*"/>  <!-- table (접기 가능) -->
        </Grid.RowDefinitions>

        <!-- Filter + actions -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCount" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnUpload" Content="엑셀 업로드" Style="{StaticResource BtnPrimary}" Click="BtnUpload_Click"/>
                    <Button x:Name="BtnDownload" Content="다운로드" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Click="BtnDownload_Click"/>
                    <Button x:Name="BtnClear" Content="전체 삭제" Style="{StaticResource BtnDanger}" Margin="6,0,0,0" Click="BtnClear_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F3F4F6" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbBar" Content="설비별 비교" Style="{StaticResource SegItem}" IsChecked="True" Checked="Mode_Changed"/>
                            <RadioButton x:Name="RbTrend" Content="기간별 추이" Style="{StaticResource SegItem}" Checked="Mode_Changed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="설비 유형" Style="{StaticResource LblSmall}"/>
                    <local:MultiSelectFilter x:Name="FltProcess" Width="96"/>
                    <TextBlock Text="약액" Style="{StaticResource LblSmall}"/>
                    <local:MultiSelectFilter x:Name="FltBath" Width="96"/>
                    <TextBlock Text="설비" Style="{StaticResource LblSmall}"/>
                    <local:MultiSelectFilter x:Name="FltEquip" Width="120"/>
                    <TextBlock x:Name="LblDate" Text="날짜" Style="{StaticResource LblSmall}"/>
                    <Grid>
                        <Button x:Name="DateButton" Click="DateButton_Click" Cursor="Hand" Width="132" Height="34" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="db" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="db" Property="BorderBrush" Value="#C7D2FE"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Text="전체" FontSize="13" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="12" Width="272">
                                <Border.Effect><DropShadowEffect BlurRadius="18" Opacity="0.16" ShadowDepth="4" Direction="270"/></Border.Effect>
                                <StackPanel>
                                    <DockPanel Margin="2,0,2,8">
                                        <Button x:Name="CalPrev" DockPanel.Dock="Left" Content="◀" Style="{StaticResource CalNav}" Click="CalPrev_Click"/>
                                        <Button x:Name="CalNext" DockPanel.Dock="Right" Content="▶" Style="{StaticResource CalNav}" Click="CalNext_Click"/>
                                        <TextBlock x:Name="CalTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                                    </DockPanel>
                                    <UniformGrid Columns="7" Margin="0,0,0,4">
                                        <TextBlock Text="일" HorizontalAlignment="Center" FontSize="11" Foreground="#EF4444"/>
                                        <TextBlock Text="월" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Text="화" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Text="수" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Text="목" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Text="금" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Text="토" HorizontalAlignment="Center" FontSize="11" Foreground="#3B82F6"/>
                                    </UniformGrid>
                                    <UniformGrid x:Name="CalDays" Columns="7" Rows="6"/>
                                    <Border Height="1" Background="#F1F5F9" Margin="0,6"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="● 측정 기록 있는 날" FontSize="11" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <Button Content="초기화" HorizontalAlignment="Right" Style="{StaticResource BtnGhost}"
                                                Padding="12,4" FontSize="12" Foreground="#DC2626" BorderBrush="#FECACA" Click="CalReset_Click"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="LblPeriod" Text="단위" Style="{StaticResource LblSmall}"/>
                    <ComboBox x:Name="CmbPeriod" Style="{StaticResource ModernCombo}" Width="84" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="일별"/>
                        <ComboBoxItem Content="월별" IsSelected="True"/>
                        <ComboBoxItem Content="년별"/>
                    </ComboBox>
                    <Button x:Name="BtnResetFilters" Content="필터 초기화" Style="{StaticResource BtnGhost}"
                            Margin="14,0,0,0" Padding="12,7" FontSize="12" Foreground="#DC2626" BorderBrush="#FECACA"
                            Click="ResetFilters_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Element chips -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12,14,6">
            <DockPanel>
                <TextBlock Text="원소" FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                           VerticalAlignment="Top" Margin="0,4,12,0" DockPanel.Dock="Left"/>
                <WrapPanel x:Name="ChipPanel"/>
            </DockPanel>
        </Border>

        <!-- 요약 카드 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="측정 건수" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TxtStatCount" Text="-" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="TxtStatCountSub" Text="" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="최근 측정일" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TxtStatLatest" Text="-" Style="{StaticResource StatValue}"/>
                    <TextBlock x:Name="TxtStatLatestSub" Text="" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="최고 오염" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TxtStatMax" Text="-" Style="{StaticResource StatValue}" Foreground="#DC2626"/>
                    <TextBlock x:Name="TxtStatMaxWho" Text="" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Text="평균 (선택 원소)" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TxtStatAvg" Text="-" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="ppb" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chart card (헤더 클릭으로 접기/펼치기 → 접으면 표가 커짐) -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Top" Click="ToggleChart_Click" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="hb" Background="White" CornerRadius="14" Padding="16,11"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hb" Property="Background" Value="#F9FAFB"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock x:Name="ChartArrow" DockPanel.Dock="Right" Text="▾" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="차트" FontSize="13" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Border x:Name="ChartBody" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="14,12">
                    <Grid>
                        <lvc:CartesianChart x:Name="Chart"/>
                        <TextBlock x:Name="TxtEmpty" Text="데이터가 없습니다. '엑셀 업로드'로 분석 데이터를 추가하세요."
                                   Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Data table card (헤더 클릭으로 접기/펼치기 → 접으면 차트가 커짐) -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel x:Name="TableInner" SizeChanged="TableInner_SizeChanged">
                <Button DockPanel.Dock="Top" Click="ToggleTable_Click" Cursor="Hand" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="hb" Background="White" CornerRadius="14" Padding="16,11"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hb" Property="Background" Value="#F9FAFB"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock x:Name="TableArrow" DockPanel.Dock="Right" Text="▾" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="데이터 표" FontSize="13" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTableCount" Margin="8,0,0,0" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Border x:Name="TableBody" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                <DataGrid x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6" FontSize="12" Foreground="#374151"
                          Background="White" BorderThickness="0" RowHeaderWidth="0" RowHeight="32"
                          ColumnWidth="*" ColumnHeaderStyle="{StaticResource GridHeader}"
                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          CanUserAddRows="False" AlternatingRowBackground="#FCFCFD">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="2,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
