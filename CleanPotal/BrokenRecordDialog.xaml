<Window x:Class="CleanPotal.BrokenRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파손 기록 추가" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Tb" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cb" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsEditable" Value="True"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">
        <TextBlock Text="파손 기록 추가" FontSize="16" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 발생일 / 처리현황 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="발생일 *" Style="{StaticResource Lbl}"/>
            <DatePicker x:Name="DpOccurDate" Grid.Row="1" Grid.Column="0"
                        Height="32" Margin="0,0,0,12" FontSize="13" BorderBrush="#E2E8F0"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="처리현황" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtStatus" Grid.Row="1" Grid.Column="2" Style="{StaticResource Tb}"/>

            <!-- 라인 / 팀 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="라인" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="CmbLine" Grid.Row="3" Grid.Column="0" Style="{StaticResource Cb}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="팀" Style="{StaticResource Lbl}"/>
            <ComboBox x:Name="CmbTeam" Grid.Row="3" Grid.Column="2" Style="{StaticResource Cb}"/>

            <!-- 제품명 (full width) -->
            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="제품명" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtProductName" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Tb}"/>

            <!-- S/N / 제품종류 -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="S/N" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtSN" Grid.Row="7" Grid.Column="0" Style="{StaticResource Tb}"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Text="제품종류" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtProductType" Grid.Row="7" Grid.Column="2" Style="{StaticResource Tb}"/>

            <!-- 유발자 / 직위 -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="유발자" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtCauser" Grid.Row="9" Grid.Column="0" Style="{StaticResource Tb}"/>
            <TextBlock Grid.Row="8" Grid.Column="2" Text="직위" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtJobTitle" Grid.Row="9" Grid.Column="2" Style="{StaticResource Tb}"/>

            <!-- 발생단계 / 공식여부 -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="발생단계" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtOccurStage" Grid.Row="11" Grid.Column="0" Style="{StaticResource Tb}"/>
            <TextBlock Grid.Row="10" Grid.Column="2" Text="공식여부" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtIsOfficial" Grid.Row="11" Grid.Column="2" Style="{StaticResource Tb}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="취소" Style="{StaticResource ActionBtn}"
                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                    Foreground="#334155" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="추가" Style="{StaticResource ActionBtn}"
                    Background="#2563EB" BorderBrush="#2563EB" BorderThickness="1"
                    Foreground="White" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
